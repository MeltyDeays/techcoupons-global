# =============================================================================
# VARIABLES DE ENTORNO — RADAR OFICIAL DE CUPONES (CUPONESTECH)
# =============================================================================
# Copia este archivo como .env para desarrollo local o añade estas variables
# en el panel de Vercel (Project Settings -> Environment Variables).

# --- 1. SEGURIDAD DEL CRON (Vercel Cron / Webhooks) ---
# Token secreto para autorizar la sincronización semanal en /api/sync-coupons
CRON_SECRET=tu_clave_secreta_aleatoria_aqui

# --- 2. ADMITAD API (Red de Afiliados Oficial) ---
# Opción A (Recomendada - Autenticación OAuth2 Automática):
ADMITAD_CLIENT_ID=
ADMITAD_CLIENT_SECRET=
ADMITAD_WEBSITE_ID=

# Opción B (Token de Acceso Directo):
# ADMITAD_API_TOKEN=

# --- 3. ALIEXPRESS PORTALS (Open Platform API) ---
# Obtenidos en https://portals.aliexpress.com (App Management / Open Platform)
ALI_APP_KEY=
ALI_APP_SECRET=
ALI_TRACKING_ID=

# --- 4. TEMU PROGRAMA DE AFILIADOS ---
# En Temu los cupones son tus códigos personales de referido por país (para cuentas nuevas).
# Configura tu tracking URL base en src/config/affiliateConfig.js
